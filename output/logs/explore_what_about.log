. label define catlbl ///
>     1 "Mentions flu or vaccine" ///
>     2 "Mentions attitudes or opinions" ///
>     3 "Mentions information or research" ///
>     4 "Side effects or effectiveness" ///
>     5 "Mentions vaccination intentions" ///
>     6 "Mentions changing behavior" ///
